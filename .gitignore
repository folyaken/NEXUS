# dependencies
node_modules/

# build output
dist/
dist-electron/
release/
out/

# logs and caches
*.log
npm-debug.log*
.cache/
modules/.cache/
modules/logs/
modules/bin/
modules/configs/vpn/generated_config.json
modules/configs/vpn/*.json
!modules/configs/vpn/.gitkeep

# env and secrets
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# archives and installers (keep source only)
# Патч-архивы собираются через `npm run patch`. В корне они не накапливаются:
# для скачивания публикуется только текущий патч в patches/.
/NEXUS-patch-*.zip
*.rar
*.7z
*.exe
*.AppImage
*.dmg
*.apk

# Личный адрес канала обновлений: у каждого свой
update-channel.json

# generated brand fonts (rebuilt from assets/fonts via tools/convert_fonts.py)
tools/fonts/
