{
  "name": "nexus-network-tools",
  "version": "1.1.0",
  "private": true,
  "description": "NEXUS — локальная Electron-обёртка для сетевых инструментов",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/ensure-xray.cjs && node scripts/ensure-singbox.cjs && npm run build:main && concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run start:standalone",
    "start:standalone": "node scripts/ensure-xray.cjs && node scripts/ensure-singbox.cjs && npm run build && node scripts/launch-standalone.cjs",
    "package:win": "node scripts/ensure-xray.cjs && node scripts/ensure-singbox.cjs && npm run build && electron-builder --win --x64",
    "postinstall": "node scripts/ensure-xray.cjs && node scripts/ensure-singbox.cjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "test:split-tunnel": "npm run build:main && node tests/split-tunnel-config.test.cjs",
    "test:subscription-security": "npm run build:main && node tests/subscription-security.test.cjs",
    "test:parser-security": "npm run build:main && node tests/parser-security.test.cjs",
    "test:subscription-refresh": "npm run build:main && node tests/subscription-refresh.test.cjs",
    "test:subscription-management": "npm run build:main && node tests/subscription-management.test.cjs",
    "test:vpn-diagnostics": "npm run build:main && node tests/vpn-diagnostics.test.cjs",
    "test:vpn-latency": "npm run build:main && node tests/vpn-latency-sampling.test.cjs",
    "test:vpn-live-mode": "npm run build:main && node tests/vpn-live-mode-session.test.cjs",
    "package": "npm run build && electron-builder",
    "preview": "vite preview --host 0.0.0.0"
  },
  "build": {
    "appId": "ai.arena.nexus",
    "productName": "NEXUS",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "modules/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "nexus-tray.png",
          "nexus-app.png",
          "nexus.ico",
          "tray/**/*"
        ]
      }
    ],
    "asar": true,
    "icon": "assets/nexus.ico",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/nexus.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    }
  },
  "dependencies": {
    "@react-spring/web": "^9.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
